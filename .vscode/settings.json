{
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#042f66",
    "activityBar.background": "#042f66",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#1f010e",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#064697",
    "statusBar.background": "#042f66",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#042f66",
    "statusBarItem.remoteBackground": "#042f66",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#042f66",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#042f66",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#042f66",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.enableShellIntegration": true,
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "icon": "terminal-bash"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
}